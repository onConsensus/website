---
layout: null
sitemap: false
---
{%- comment -%}
  axis-rss.xml — RSS 2.0 layout for any taxonomy axis.

  Pages selecting this layout supply two frontmatter fields:
    axis       — section | author | series | tag | glossary | list
    axis_value — slug of the axis member

  The page itself is a stub (no body); all rendering happens here.
{%- endcomment -%}
{% include axis-posts.html %}
{%- assign feed_url = page.url | absolute_url -%}
{%- assign axis_url = page.axis_archive_url | default: page.url -%}
{%- assign axis_url = axis_url | absolute_url -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.title | xml_escape }} — {{ axis_label | xml_escape }}</title>
    <description>{{ axis_blurb | default: site.description | xml_escape }}</description>
    <link>{{ axis_url }}</link>
    <atom:link href="{{ feed_url }}" rel="self" type="application/rss+xml"/>
    <language>{{ site.lang | default: "en" }}</language>
    <copyright>{{ site.license.content | default: "CC-BY-SA-4.0" | xml_escape }}</copyright>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }} (hand-rolled, axis={{ page.axis | xml_escape }})</generator>
    {%- for post in axis_posts limit: 30 -%}
      {%- assign author = site.authors | where: "slug", post.author | first -%}
      {%- assign section = site.data.sections | where: "slug", post.section | first -%}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        {%- if author -%}<dc:creator>{{ author.name | xml_escape }}</dc:creator>{%- endif -%}
        {%- if section -%}<category>{{ section.title | xml_escape }}</category>{%- endif -%}
        {%- for tag in post.tags -%}<category>{{ tag | xml_escape }}</category>{%- endfor -%}
        {%- if post.subtitle -%}
          <description>{{ post.subtitle | strip_html | strip_newlines | xml_escape }}</description>
        {%- elsif post.excerpt -%}
          <description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description>
        {%- endif -%}
        <content:encoded><![CDATA[{{ post.content }}]]></content:encoded>
      </item>
    {%- endfor -%}
  </channel>
</rss>
