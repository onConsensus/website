---
layout: null
sitemap: false
---
{%- comment -%}
  axis-jsonfeed.json — JSON Feed 1.1 layout for any taxonomy axis.
{%- endcomment -%}
{% include axis-posts.html %}
{%- assign axis_url = page.axis_archive_url | default: page.url | absolute_url -%}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | append: " — " | append: axis_label | jsonify }},
  "description": {{ axis_blurb | default: site.description | strip_newlines | jsonify }},
  "home_page_url": {{ axis_url | jsonify }},
  "feed_url": {{ page.url | absolute_url | jsonify }},
  "language": {{ site.lang | default: "en" | jsonify }},
  "icon": {{ '/favicon.ico' | absolute_url | jsonify }},
  "favicon": {{ '/favicon.ico' | absolute_url | jsonify }},
  "items": [
    {%- for post in axis_posts limit: 30 -%}
      {%- assign author = site.authors | where: "slug", post.author | first -%}
      {%- assign section = site.data.sections | where: "slug", post.section | first -%}
      {%- assign permaid = site.data.permaids[post.slug] -%}
      {
        "id": {{ post.url | absolute_url | jsonify }},
        "url": {{ post.url | absolute_url | jsonify }},
        "title": {{ post.title | jsonify }},
        {%- if post.subtitle %}"summary": {{ post.subtitle | strip_newlines | jsonify }},
        {%- elsif post.excerpt %}"summary": {{ post.excerpt | strip_html | strip_newlines | jsonify }},{%- endif %}
        "content_html": {{ post.content | jsonify }},
        "date_published": {{ post.date | date_to_xmlschema | jsonify }},
        {%- if post.last_modified_at %}"date_modified": {{ post.last_modified_at | date_to_xmlschema | jsonify }},{%- endif %}
        {%- if author %}"authors": [{ "name": {{ author.name | jsonify }}, "url": {{ author.url | absolute_url | jsonify }} }],{%- endif %}
        "tags": [
          {%- if section %}{{ section.slug | jsonify }}{%- if post.tags and post.tags.size > 0 -%},{%- endif -%}{%- endif -%}
          {%- for tag in post.tags -%}{{ tag | jsonify }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
        ]
        {%- if permaid %},"_oc": { "permaid": {{ permaid | jsonify }} }{%- endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
