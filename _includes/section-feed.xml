{%- comment -%}
  section-feed.xml — RSS 2.0 body for a single editorial section.
  Parameters:
    section_slug — slug of an entry in `site.data.sections` (required).
{%- endcomment -%}
{%- assign section_slug = include.section_slug -%}
{%- assign section = site.data.sections | where: "slug", section_slug | first -%}
{%- assign section_posts = site.posts | where: "section", section_slug -%}
{%- assign section_url = '/sections/' | append: section_slug | append: '/' | absolute_url -%}
{%- assign feed_url = '/sections/' | append: section_slug | append: '/feed.xml' | absolute_url -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.title | xml_escape }} — {{ section.title | xml_escape }}</title>
    <description>{{ section.blurb | default: site.description | xml_escape }}</description>
    <link>{{ section_url }}</link>
    <atom:link href="{{ feed_url }}" rel="self" type="application/rss+xml"/>
    <language>{{ site.lang | default: "en" }}</language>
    <copyright>{{ site.license.content | default: "CC-BY-SA-4.0" | xml_escape }}</copyright>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }} (hand-rolled)</generator>
    {%- for post in section_posts limit: 30 -%}
      {%- assign author = site.authors | where: "slug", post.author | first -%}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        {%- if author -%}
          <dc:creator>{{ author.name | xml_escape }}</dc:creator>
        {%- endif -%}
        <category>{{ section.title | xml_escape }}</category>
        {%- for tag in post.tags -%}
          <category>{{ tag | xml_escape }}</category>
        {%- endfor -%}
        {%- if post.excerpt -%}
          <description>{{ post.excerpt | strip_html | strip_newlines | xml_escape }}</description>
        {%- endif -%}
        <content:encoded xmlns:content="http://purl.org/rss/1.0/modules/content/"><![CDATA[{{ post.content }}]]></content:encoded>
      </item>
    {%- endfor -%}
  </channel>
</rss>
