source 'https://rubygems.org'

gem "bundler"

# GitHub Pages safe-mode gem. Pulls in Jekyll plus the
# allow-listed plugins at the exact versions GitHub Pages runs.
# https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

# GitHub-Pages-allowed plugins
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-redirect-from"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
end

# Webrick is no longer bundled with Ruby 3.x
gem "webrick"
