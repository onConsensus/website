---
layout: null
permalink: /feed.json
sitemap: false
---
{%- assign feed_posts = site.posts | slice: 0, 30 -%}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "home_page_url": {{ '/' | absolute_url | jsonify }},
  "feed_url": {{ '/feed.json' | absolute_url | jsonify }},
  "language": {{ site.lang | default: "en" | jsonify }},
  "icon": {{ '/favicon.ico' | absolute_url | jsonify }},
  "favicon": {{ '/favicon.ico' | absolute_url | jsonify }},
  "authors": [
    {%- for a in site.authors -%}
      {
        "name": {{ a.name | jsonify }},
        "url": {{ a.url | absolute_url | jsonify }}{%- if a.avatar %},
        "avatar": {{ a.avatar | absolute_url | jsonify }}{%- endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "items": [
    {%- for post in feed_posts -%}
      {%- assign author = site.authors | where: "slug", post.author | first -%}
      {%- assign section = site.sections | where: "slug", post.section | first -%}
      {
        "id": {{ post.url | absolute_url | jsonify }},
        "url": {{ post.url | absolute_url | jsonify }},
        "title": {{ post.title | jsonify }},
        {%- if post.subtitle %}
        "summary": {{ post.subtitle | strip_newlines | jsonify }},
        {%- elsif post.excerpt %}
        "summary": {{ post.excerpt | strip_html | strip_newlines | jsonify }},
        {%- endif %}
        "content_html": {{ post.content | jsonify }},
        "date_published": {{ post.date | date_to_xmlschema | jsonify }},
        {%- if post.last_modified_at %}
        "date_modified": {{ post.last_modified_at | date_to_xmlschema | jsonify }},
        {%- endif %}
        {%- if post.featured_image %}
        "image": {{ post.featured_image | absolute_url | jsonify }},
        {%- endif %}
        {%- if author %}
        "authors": [
          {
            "name": {{ author.name | jsonify }},
            "url": {{ author.url | absolute_url | jsonify }}{%- if author.avatar %},
            "avatar": {{ author.avatar | absolute_url | jsonify }}{%- endif %}
          }
        ],
        {%- endif %}
        "tags": [
          {%- if section -%}{{ section.slug | jsonify }}{%- if post.tags.size > 0 -%},{%- endif -%}{%- endif -%}
          {%- for tag in post.tags -%}{{ tag | jsonify }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
        ],
        "_on_consensus": {
          "section": {{ post.section | default: "" | jsonify }},
          "series": {{ post.series | default: "" | jsonify }},
          "license": {{ post.license | default: site.license.content | jsonify }},
          "pgp_signed": {%- if post.pgp_signed -%}true{%- else -%}false{%- endif -%},
          "block_height": {%- if post.block_height -%}{{ post.block_height }}{%- else -%}null{%- endif -%}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
